# Kafka Connect -> S3 (Yandex Object Storage), same shape as ASSET_S3_* / AUTH_S3_*.
# Copy to kafka-connect/.env. Deploy secret: KAFKA_CONNECT_ENV (full file contents).
# Local: docker compose --profile s3-export up -d --build

KAFKA_S3_BUCKET=kafkalogs
KAFKA_S3_REGION=ru-central1
KAFKA_S3_ENDPOINT_URL=https://storage.yandexcloud.net
KAFKA_S3_FORCE_PATH_STYLE=false
KAFKA_S3_ACCESS_KEY_ID=
KAFKA_S3_SECRET_ACCESS_KEY=

KAFKA_S3_TOPICS_DIR=storm-training
KAFKA_S3_FLUSH_SIZE=1000
KAFKA_S3_ROTATE_INTERVAL_MS=600000
