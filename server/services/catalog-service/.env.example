# Catalog service (systems in Postgres via SQLAlchemy).
CATALOG_HOST=0.0.0.0
CATALOG_PORT=8003

# Use SQLAlchemy URL form:
#   postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
CATALOG_DATABASE_URL=postgresql+psycopg://galaxy:galaxy@postgres:5432/galaxy

# Optional offline seed paths (not mounted in production).
# If missing and DB already has rows, catalog just serves from Postgres.
CATALOG_GALAXY_INDEX_PATH=/data/galaxy-index.json
CATALOG_SYSTEMS_DIR=/data/systems
CATALOG_SEED_ON_STARTUP=true
CATALOG_SEED_FULL_SYNC=false

# Optional Redis response cache. Docker Compose sets this automatically.
CATALOG_REDIS_URL=redis://redis:6379/0
CATALOG_REDIS_GALAXY_TTL_SECONDS=300
CATALOG_REDIS_SYSTEM_TTL_SECONDS=900

# Must match GATEWAY_INTERNAL_SERVICE_TOKEN to protect mutation endpoints.
CATALOG_INTERNAL_SERVICE_TOKEN=change-me
