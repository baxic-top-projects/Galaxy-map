# S3 / S3-compatible object storage for galaxy GLB models.
#
# Expected object keys (prefix ASSET_S3_PREFIX=models/):
#   models/stars/star_type_<key>.glb
#   models/stars/star_type_<key>_preview.png
#   models/planets/planet_type_<key>.glb
#   models/planets/planet_type_<key>_preview.png
#   models/features/system_feature_<key>.glb
#   models/features/system_feature_<key>_preview.png
#
# Browser loads GLBs directly from ASSET_S3_PUBLIC_BASE_URL (CDN/public bucket).
# This service only returns a JSON manifest of URLs.

ASSET_HOST=0.0.0.0
ASSET_PORT=8002

ASSET_S3_BUCKET=galaxy-map-assets
ASSET_S3_REGION=ru-central1
# Leave empty for AWS. For Yandex Object Storage:
# ASSET_S3_ENDPOINT_URL=https://storage.yandexcloud.net
# For MinIO:
# ASSET_S3_ENDPOINT_URL=http://minio:9000
# ASSET_S3_FORCE_PATH_STYLE=true
ASSET_S3_ENDPOINT_URL=
ASSET_S3_FORCE_PATH_STYLE=false
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_PREFIX=models/

# Public URL prefix seen by the browser (no trailing slash).
# Yandex example: https://storage.yandexcloud.net/galaxy-map-assets
# CDN example:    https://cdn.galaxy.baxic.ru
ASSET_S3_PUBLIC_BASE_URL=

# Private bucket: set true and omit/ignore public base for object access.
ASSET_PRESIGN_ENABLED=false
ASSET_PRESIGN_TTL_SECONDS=3600
ASSET_MANIFEST_CACHE_SECONDS=60
