# Auth service
AUTH_HOST=0.0.0.0
AUTH_PORT=8004
AUTH_DATABASE_URL=postgresql+psycopg://galaxy:galaxy@postgres:5432/galaxy

# Generate independent high-entropy values; never commit real secrets.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=galaxy-auth
AUTH_JWT_AUDIENCE=galaxy-services
AUTH_INTERNAL_SERVICE_TOKEN=replace-with-an-independent-random-token
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_EMAIL_TOKEN_MINUTES=60
AUTH_RESET_TOKEN_MINUTES=30
AUTH_EXCHANGE_CODE_MINUTES=2
AUTH_FRONTEND_URL=http://localhost:3000

# SMTP verification and password reset delivery.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=no-reply@example.com
AUTH_SMTP_FROM_NAME=Galaxy Map
AUTH_SMTP_STARTTLS=true
AUTH_SMTP_SSL=false

# Google server-side OAuth.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
AUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# S3-compatible avatar storage.
AUTH_S3_BUCKET=
AUTH_S3_REGION=ru-central1
AUTH_S3_ENDPOINT_URL=
AUTH_S3_ACCESS_KEY_ID=
AUTH_S3_SECRET_ACCESS_KEY=
AUTH_S3_PUBLIC_BASE_URL=
AUTH_S3_AVATAR_PREFIX=avatars/
AUTH_AVATAR_MAX_BYTES=5242880

# MailDev auto-relay provider (read by docker-compose smtp-service-galaxy).
SMTP_OUTGOING_HOST=
SMTP_OUTGOING_PORT=465
SMTP_OUTGOING_USER=
SMTP_OUTGOING_PASSWORD=
