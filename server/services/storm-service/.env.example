# Galaxy graph is loaded from catalog-service (Postgres), not from local JSON.
STORM_CATALOG_SERVICE_URL=http://catalog-service:8003
STORM_CATALOG_TIMEOUT_SECONDS=60

STORM_SEED=20260928
STORM_TICK_SECONDS=2
STORM_MAX_ACTIVE_STORMS=8
STORM_SPAWN_CHANCE=0.35
STORM_FORM_TICKS=4
STORM_ACTIVE_TICKS=18
STORM_DISSIPATE_TICKS=8
STORM_MAX_RADIUS_HOPS=2

# Ticks to crawl along one hyperlane (higher = slower Stellaris-like travel).
STORM_MOVE_INTERVAL_TICKS=3
STORM_PATH_HOPS_MIN=6
STORM_PATH_HOPS_MAX=16

STORM_HOST=0.0.0.0
STORM_PORT=8001

# 0/1 = single process (async I/O only). >1 = ProcessPool for storm advances.
STORM_WORKER_PROCESSES=0

STORM_KAFKA_ENABLED=true
STORM_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
STORM_KAFKA_TOPIC=galaxy.storms
