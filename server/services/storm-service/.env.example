# Path to galaxy index inside the container (compose mounts the file here).
STORM_GALAXY_INDEX_PATH=/data/galaxy-index.json

STORM_SEED=20260928
STORM_TICK_SECONDS=2
STORM_MAX_ACTIVE_STORMS=8
STORM_SPAWN_CHANCE=0.35
STORM_FORM_TICKS=4
STORM_ACTIVE_TICKS=18
STORM_DISSIPATE_TICKS=8
STORM_MAX_RADIUS_HOPS=4

# Bind address inside the container. Keep 0.0.0.0 in Docker.
STORM_HOST=0.0.0.0

# Internal container port (not published publicly; only api-gateway reaches it).
STORM_PORT=8001

# Kafka broker (docker service name). Used later for event bus.
STORM_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
