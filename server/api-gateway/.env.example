# Internal Docker DNS name of storm-service (not a public host).
GATEWAY_STORM_SERVICE_URL=http://storm-service:8001

# Origins allowed to call the gateway from the browser.
# Include the public client URL(s).
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9999,http://127.0.0.1:9999

# Bind address inside the container. Keep 0.0.0.0 in Docker.
GATEWAY_HOST=0.0.0.0

# Port inside the container (mapped to host 9998 in docker-compose).
GATEWAY_PORT=8000

GATEWAY_REQUEST_TIMEOUT_SECONDS=5
