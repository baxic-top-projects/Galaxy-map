# Internal Docker DNS name of storm-service (not a public host).
GATEWAY_STORM_SERVICE_URL=http://storm-service:8001

# Internal Docker DNS name of asset-service (S3 manifest).
GATEWAY_ASSET_SERVICE_URL=http://asset-service:8002

# Internal Docker DNS name of catalog-service (systems DB).
GATEWAY_CATALOG_SERVICE_URL=http://catalog-service:8003

# Origins allowed to call the gateway from the browser.
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9999,http://127.0.0.1:9999

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Galaxy index can be multi-MB; keep a higher timeout.
GATEWAY_REQUEST_TIMEOUT_SECONDS=60
