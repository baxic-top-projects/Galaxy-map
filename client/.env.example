# Browser-facing API base URL (baked into the JS bundle at build time).
# Local:
#   VITE_API_BASE=http://localhost:9998
#   VITE_WS_URL=ws://localhost:9998
# Production:
#   VITE_API_BASE=https://galaxyapi.baxic.ru
#   VITE_WS_URL=wss://galaxyapi.baxic.ru
#
# Optional direct CDN/S3 public base for models (overrides local /models when set).
# Prefer loading URLs from /api/v1/assets/manifest; this is a static fallback only.
#   VITE_ASSETS_BASE=https://storage.yandexcloud.net/galaxy-map-assets
VITE_API_BASE=http://localhost:9998
VITE_WS_URL=ws://localhost:9998
