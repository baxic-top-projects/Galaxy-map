# Browser-facing API base URL (baked into the JS bundle at build time).
# Local:
#   VITE_API_BASE=http://localhost:9998
#   VITE_WS_URL=ws://localhost:9998
# Production:
#   VITE_API_BASE=https://galaxyapi.baxic.ru
#   VITE_WS_URL=wss://galaxyapi.baxic.ru
#
# Models/textures live in S3. Prefer /api/v1/assets/manifest;
# VITE_ASSETS_BASE is a static fallback for GLB/PNG paths.
#   VITE_ASSETS_BASE=https://storage.yandexcloud.net/galaxybucket
VITE_API_BASE=http://localhost:9998
VITE_WS_URL=ws://localhost:9998
VITE_ASSETS_BASE=https://storage.yandexcloud.net/galaxybucket
